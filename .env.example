# ==============================================================================
# ORBIT / NEURO COGNITIVE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (SQLite default, or Postgres URL)
DATABASE_URL=sqlite:///./orbit.db

# OpenAI API (Required for AI Game Generation & Akinator Student Intake)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Devin AI Agent API (Optional - for autonomous agent loops)
DEVIN_API_KEY=
DEVIN_API_BASE=https://api.devin.ai/v1

# PostHog Analytics & Telemetry (Optional)
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=

# Storage & CORS
GAMES_ROOT=games
REPO_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*
