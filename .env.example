# Orbit falls back to SQLite when DATABASE_URL is unset.
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEVIN_API_KEY=
DEVIN_API_BASE=https://api.devin.ai/v1
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
# Must match the region the PostHog project lives in: us.i.posthog.com or
# eu.i.posthog.com. Ingestion on the wrong region accepts events and drops them.
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=
GAMES_ROOT=games
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
